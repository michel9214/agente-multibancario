generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  OPERATOR
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum BalanceType {
  OPENING
  CLOSING
}

enum MovementType {
  CASH_INJECTION
  BALANCE_INJECTION
  ATM_WITHDRAWAL
  PERSONAL_PAYMENT
  BUSINESS_PAYMENT
  OTHER
}

enum MovementDirection {
  IN
  OUT
}

enum EntityType {
  BANK
  INTERMEDIARY
  FINTECH
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  fullName     String   @map("full_name")
  photoUrl     String?  @map("photo_url")
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shifts Shift[]

  @@map("users")
}

model BankingEntity {
  id       String     @id @default(uuid())
  name     String     @unique
  type     EntityType @default(BANK)
  color    String     @default("#1976D2")
  isActive Boolean    @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  balanceEntries BalanceEntry[]

  @@map("banking_entities")
}

model Shift {
  id         String      @id @default(uuid())
  operatorId String      @map("operator_id")
  status     ShiftStatus @default(OPEN)
  startedAt  DateTime    @default(now()) @map("started_at")
  closedAt   DateTime?   @map("closed_at")

  startingCash Decimal @default(0) @map("starting_cash") @db.Decimal(12, 2)
  sencillo     Decimal @default(0) @db.Decimal(12, 2)
  endingCash   Decimal? @map("ending_cash") @db.Decimal(12, 2)

  totalOpeningBalance Decimal? @map("total_opening_balance") @db.Decimal(12, 2)
  totalClosingBalance Decimal? @map("total_closing_balance") @db.Decimal(12, 2)
  totalMovements      Decimal? @map("total_movements") @db.Decimal(12, 2)
  discrepancy         Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operator       User           @relation(fields: [operatorId], references: [id])
  balanceEntries BalanceEntry[]
  movements      Movement[]

  @@map("shifts")
}

model BalanceEntry {
  id       String      @id @default(uuid())
  shiftId  String      @map("shift_id")
  entityId String      @map("entity_id")
  type     BalanceType
  amount   Decimal     @db.Decimal(12, 2)
  receiptPhotoUrl String? @map("receipt_photo_url")

  createdAt DateTime @default(now()) @map("created_at")

  shift  Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  entity BankingEntity @relation(fields: [entityId], references: [id])

  @@unique([shiftId, entityId, type])
  @@map("balance_entries")
}

model MovementReason {
  id               String           @id @default(uuid())
  name             String           @unique
  defaultDirection MovementDirection @map("default_direction")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  movements Movement[]

  @@map("movement_reasons")
}

model Movement {
  id        String            @id @default(uuid())
  shiftId   String            @map("shift_id")
  type      MovementType
  reasonId  String?           @map("reason_id")
  direction MovementDirection
  amount    Decimal           @db.Decimal(12, 2)
  description String?
  receiptPhotoUrl String?     @map("receipt_photo_url")

  createdAt DateTime @default(now()) @map("created_at")

  shift  Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  reason MovementReason? @relation(fields: [reasonId], references: [id])

  @@map("movements")
}
